{
  "name": "db-redis",
  "image": "${image_url}",
  "cpu": 1024,
  "memory":  2048,
  "essential": false,
  "portMappings": [
    {
      "containerPort": 6379,
      "hostPort": 6379,
      "protocol" : "tcp"
    }
  ],
  "healthCheck": {
    "command": [
      "CMD-SHELL",
      "redis-cli -h 127.0.0.1 -p 6379 ping | grep -q PONG"
    ],
    "interval": 10,
    "timeout": 5,
    "retries": 5,
    "startPeriod": 10
  },
  "logConfiguration": {
    "logDriver": "awslogs",
    "options": {
        "awslogs-region": "${awslogs_region}",
        "awslogs-group": "${awslogs_group}",
        "awslogs-stream-prefix": "redis"
    }
  }
}
